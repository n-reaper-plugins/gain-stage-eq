desc:GainStageEQ Trim
tags:utility gain
// Gain Stage EQ v0.1.0 - GENERATED by GainStageEQ.lua / tools/build.lua. Do not edit by hand.
// A plain gain in dB with a short glide (no zipper noise). The Gain Stage EQ action sets it
// when "Apply gain via" is "JSFX trim"; you can also use it on its own.

slider1:0<-60,24,0.01>Trim (dB)

@init
jsfx_version = 100;
g = 1;
tgt = 1;

@slider
tgt = 10^(slider1/20);
coef = 1 - exp(-1/(0.010*srate));

@sample
g += (tgt - g) * coef;
spl0 *= g;
spl1 *= g;

@gfx 260 26
gfx_set(0.85, 0.85, 0.85, 1);
gfx_x = 8; gfx_y = 6;
gfx_drawstr(sprintf(#, "Gain Stage EQ trim v0.1.0: %+.2f dB", slider1));
